--- a/litert/runtime/custom_buffer.cc
+++ b/litert/runtime/custom_buffer.cc
@@ -20,0 +21 @@
+#include "litert/c/internal/litert_logging.h"
@@ -75,5 +76,2 @@ LITERT_NO_CFI_CHECK CustomBuffer::~CustomBuffer() {
-  LITERT_ASSIGN_OR_ABORT(auto registry, GetTensorBufferRegistry(env_));
-  LITERT_ASSIGN_OR_ABORT(auto custom_buffer_handlers,
-                         registry->GetCustomHandlers(buffer_type_));
-  if (hw_memory_info_) {
-    custom_buffer_handlers.destroy_func(hw_memory_info_);
+  if (!hw_memory_info_) {
+    return;
@@ -80,0 +79,17 @@ LITERT_NO_CFI_CHECK CustomBuffer::~CustomBuffer() {
+  // The registry is owned by the LiteRtEnvironment; if the environment was
+  // destroyed first, `env_` dangles. Guard the lookups instead of aborting.
+  auto registry = GetTensorBufferRegistry(env_);
+  if (!registry) {
+    LITERT_LOG(LITERT_WARNING,
+               "Tensor buffer registry unavailable during ~CustomBuffer; "
+               "skipping H/W buffer release (possible leak).");
+    return;
+  }
+  auto custom_buffer_handlers = (*registry)->GetCustomHandlers(buffer_type_);
+  if (!custom_buffer_handlers) {
+    LITERT_LOG(LITERT_WARNING,
+               "No custom tensor buffer handlers during ~CustomBuffer; "
+               "skipping H/W buffer release (possible leak).");
+    return;
+  }
+  custom_buffer_handlers->destroy_func(hw_memory_info_);
