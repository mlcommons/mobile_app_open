    }
    custom_setting {
      id: "model_filename"
      value: "llama_q8_ekv3072_litert.tflite"
    }
  }
  delegate_selected: "GPU"
  custom_setting {
    id: "pipeline"
    value: "LLMPipeline"
  }
  custom_setting {
    id: "model_filename"
    value: "llama_q8_ekv3072.tflite"
  }
  custom_setting {
