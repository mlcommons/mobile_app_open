# proto-file: flutter/cpp/proto/backend_setting.proto
# proto-message: BackendSetting

# This backend serves only the llm-* benchmarks (LiteRT compiled-model API).
# Let the TFLite fallback cover every benchmark this backend does not claim.
fallback_policy: FALLBACK_FILL_GAPS

benchmark_setting {
  benchmark_id: "llm-1b"
  framework: "LiteRT"
  delegate_choice: {
    delegate_name: "CPU"
    accelerator_name: "cpu"
    accelerator_desc: "CPU"
    model_file: {
      model_path: "https://mobile.mlcommons-storage.org/app-resources/models/v6_0/tflite/llama_q8_ekv3072.tflite"
      model_checksum: "c618e9bbb89ce52eedcab4f61b2dc3a4"
    }
    model_file: {
      model_path: "https://mobile.mlcommons-storage.org/app-resources/datasets/v6_0/llama3_1b.spm.model"
      model_checksum: "2ad260fc18b965ce16006d76c9327082"
    }
  }
  # The GPU delegate uses a dedicated GPU export of the model; the
  # delegate-level model_filename overrides the benchmark-level one.
  # TODO(anhappdev): fill model_checksum once the upload is final.
  delegate_choice: {
    delegate_name: "GPU"
    accelerator_name: "gpu"
    accelerator_desc: "GPU"
    model_file: {
      model_path: "https://mobile.mlcommons-storage.org/app-resources/models/v6_0/tflite/llama_q8_ekv3072_gpu.tflite"
      model_checksum: ""
    }
    model_file: {
      model_path: "https://mobile.mlcommons-storage.org/app-resources/datasets/v6_0/llama3_1b.spm.model"
      model_checksum: "2ad260fc18b965ce16006d76c9327082"
    }
    custom_setting {
      id: "model_filename"
      value: "llama_q8_ekv3072_gpu.tflite"
    }
  }
  delegate_selected: "CPU"
  custom_setting {
    id: "pipeline"
    value: "LLMPipeline"
  }
  custom_setting {
    id: "model_filename"
    value: "llama_q8_ekv3072.tflite"
  }
  custom_setting {
    id: "tokenizer_filename"
    value: "llama3_1b.spm.model"
  }
}

