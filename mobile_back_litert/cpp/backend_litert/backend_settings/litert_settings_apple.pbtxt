      model_checksum: "2ad260fc18b965ce16006d76c9327082"
    }
  }
  # The Metal delegate uses the same dedicated GPU export the Android GPU
  # delegate uses; the delegate-level model_filename overrides the
  # benchmark-level one.
  delegate_choice: {
    delegate_name: "Metal"
    accelerator_name: "gpu"
    accelerator_desc: "GPU"
    model_file: {
      model_path: "https://storage.googleapis.com/mlperf-mobile-public/litert/llama_q8_ekv3072_litert.tflite"
      model_checksum: "fcabc03f8361f7081e13e89df84a0ce5"
    }
    model_file: {
