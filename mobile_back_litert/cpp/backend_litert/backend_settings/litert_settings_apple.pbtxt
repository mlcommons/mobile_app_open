# llm-3b and llm-8b are CPU-only, like the Android settings: there is no GPU
# export of those models, and the q8 CPU export does not run on the LiteRT GPU
# accelerator. Offering a Metal choice here would need a new model, so these
# stay a single delegate until one exists.
benchmark_setting {
  benchmark_id: "llm-3b"
  framework: "LiteRT"
  delegate_choice: {
    delegate_name: "CPU"
    accelerator_name: "cpu"
    accelerator_desc: "CPU"
    model_file: {
      model_path: "https://mobile.mlcommons-storage.org/app-resources/models/v6_0/tflite/llama_3b_q8_ekv3072.tflite"
      model_checksum: "6bde54c22e2be27bdad5303a0bd9cf72"
    }
    model_file: {
      model_path: "https://mobile.mlcommons-storage.org/app-resources/datasets/v6_0/llama3_1b.spm.model"
      model_checksum: "2ad260fc18b965ce16006d76c9327082"
    }
  }
  delegate_selected: "CPU"
  custom_setting {
    id: "pipeline"
    value: "LLMPipeline"
  }
  custom_setting {
    id: "model_filename"
    value: "llama_3b_q8_ekv3072.tflite"
  }
  custom_setting {
    id: "tokenizer_filename"
    value: "llama3_1b.spm.model"
  }
}

