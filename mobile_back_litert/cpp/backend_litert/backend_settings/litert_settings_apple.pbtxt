      model_checksum: "2ad260fc18b965ce16006d76c9327082"
    }
    custom_setting {
      id: "model_filename"
      value: "llama_q8_ekv3072_litert.tflite"
    }
  }
  delegate_selected: "CPU"
  custom_setting {
    id: "pipeline"
    value: "LLMPipeline"
  }
  custom_setting {
    id: "model_filename"
    value: "llama_q8_ekv3072.tflite"
  }
  custom_setting {
    id: "tokenizer_filename"
    value: "llama3_1b.spm.model"
  }
}

