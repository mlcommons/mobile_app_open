# proto-file: flutter/cpp/proto/backend_setting.proto
# proto-message: BackendSetting

# Offer the TFLite fallback next to Core ML for every benchmark, so tasks
# Core ML does not support (llm, stable_diffusion) stay available and users
# can compare backends per benchmark.
fallback_policy: FALLBACK_COEXIST

benchmark_setting {
  benchmark_id: "image_classification"
  framework: "Core ML"
  delegate_choice: {
    delegate_name: "CPU & GPU & ANE"
    accelerator_name: "cpu&gpu&ane"
    accelerator_desc: "All compute units"
    model_file: {
      model_path: "asset://assets/models/mobilenet_edgetpu_tflite_sym.mlpackage.zip"
      model_checksum: "a304535a565906a4fa15bba0947bd7da"
    }
  }
  delegate_choice: {
    delegate_name: "CPU & GPU"
